{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baobab-platform/baobab-dev/blob/main/security/decisions/development/foundation.schema.json",
  "title": "DEV-10 reusable development residual-risk decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "status",
    "revoked_at",
    "repository",
    "image_repository",
    "environment",
    "execution_scope",
    "profiles",
    "architectures",
    "prepared_by",
    "prepared_by_id",
    "approval_evidence",
    "expires_at",
    "findings",
    "finding_count",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "record_type": {
      "const": "proposed_approved_form"
    },
    "status": {
      "enum": [
        "pending_independent_review",
        "approved",
        "revoked"
      ]
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "repository": {
      "const": "baobab-platform/baobab-dev"
    },
    "image_repository": {
      "const": "ghcr.io/baobab-platform/baobab-dev"
    },
    "environment": {
      "const": "development"
    },
    "execution_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request_base",
        "pull_request_head_repository",
        "push_ref"
      ],
      "properties": {
        "pull_request_base": {
          "const": "main"
        },
        "push_ref": {
          "const": "refs/heads/main"
        },
        "pull_request_head_repository": {
          "const": "baobab-platform/baobab-dev"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "final",
          "frontend",
          "frontend-e2e",
          "infra"
        ]
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux/amd64",
          "linux/arm64"
        ]
      }
    },
    "prepared_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approval_evidence": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https://github\\.com/baobab-platform/baobab-dev/pull/[1-9][0-9]*$"
    },
    "expires_at": {
      "const": "2026-11-26T00:00:00Z"
    },
    "findings": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cve",
          "package",
          "version",
          "severity",
          "type"
        ],
        "properties": {
          "cve": {
            "enum": [
              "CVE-2022-50240",
              "CVE-2025-40190",
              "CVE-2026-68103",
              "CVE-2026-72198",
              "CVE-2026-74578",
              "CVE-2026-89805",
              "CVE-2026-98376",
              "CVE-2026-98420",
              "CVE-2026-98869",
              "CVE-2026-98890",
              "CVE-2026-99083",
              "CVE-2026-112366"
            ]
          },
          "package": {
            "enum": [
              "linux-libc-dev",
              "picomatch"
            ]
          },
          "version": {
            "enum": [
              "7.0.0-43.43",
              "4.0.5"
            ]
          },
          "severity": {
            "const": "HIGH"
          },
          "type": {
            "enum": [
              "ubuntu",
              "node-pkg"
            ]
          }
        },
        "oneOf": [
          {
            "properties": {
              "cve": {
                "enum": [
                  "CVE-2022-50240",
                  "CVE-2025-40190",
                  "CVE-2026-68103",
                  "CVE-2026-72198",
                  "CVE-2026-74578",
                  "CVE-2026-89805",
                  "CVE-2026-98376",
                  "CVE-2026-98420",
                  "CVE-2026-98869",
                  "CVE-2026-98890",
                  "CVE-2026-99083"
                ]
              },
              "package": {
                "const": "linux-libc-dev"
              },
              "version": {
                "const": "7.0.0-43.43"
              },
              "severity": {
                "const": "HIGH"
              },
              "type": {
                "const": "ubuntu"
              }
            }
          },
          {
            "properties": {
              "cve": {
                "const": "CVE-2026-112366"
              },
              "package": {
                "const": "picomatch"
              },
              "version": {
                "const": "4.0.5"
              },
              "severity": {
                "const": "HIGH"
              },
              "type": {
                "const": "node-pkg"
              }
            }
          }
        ]
      }
    },
    "finding_count": {
      "type": "integer",
      "enum": [
        8,
        12
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "prepared_by_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "evidence_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "prepared_by": {
            "type": "string",
            "minLength": 1
          },
          "approval_evidence": {
            "type": "string",
            "format": "uri"
          },
          "prepared_by_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending_independent_review"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "prepared_by": {
            "type": "null"
          },
          "approval_evidence": {
            "type": "null"
          },
          "prepared_by_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "revoked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "finding_count": {
            "const": 12
          }
        },
        "required": [
          "finding_count"
        ]
      },
      "then": {
        "required": [
          "evidence_lock_sha256"
        ]
      }
    }
  ]
}
