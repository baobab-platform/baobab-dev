{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/baobab-platform/baobab-dev/blob/main/security/decisions/development/foundation.schema.json",
  "title": "DEV-10 reusable development residual-risk decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "revoked_at",
    "repository",
    "image_repository",
    "environment",
    "execution_scope",
    "profiles",
    "architectures",
    "approval_id",
    "prepared_by",
    "approved_by",
    "approval_evidence",
    "approved_at",
    "expires_at",
    "findings",
    "finding_count",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "status": {
      "enum": [
        "pending_independent_review",
        "approved",
        "revoked"
      ]
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "repository": {
      "const": "baobab-platform/baobab-dev"
    },
    "image_repository": {
      "const": "ghcr.io/baobab-platform/baobab-dev"
    },
    "environment": {
      "const": "development"
    },
    "execution_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request_base",
        "push_ref"
      ],
      "properties": {
        "pull_request_base": {
          "const": "main"
        },
        "push_ref": {
          "const": "refs/heads/main"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "final",
          "frontend",
          "frontend-e2e",
          "infra"
        ]
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux/amd64",
          "linux/arm64"
        ]
      }
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "prepared_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approval_evidence": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https://github\\.com/baobab-platform/baobab-dev/pull/[1-9][0-9]*$"
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "const": "2026-11-26T00:00:00Z"
    },
    "findings": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cve",
          "package",
          "version",
          "severity",
          "type"
        ],
        "properties": {
          "cve": {
            "enum": [
              "CVE-2022-50240",
              "CVE-2025-40190",
              "CVE-2026-68103",
              "CVE-2026-72198",
              "CVE-2026-74578",
              "CVE-2026-89805",
              "CVE-2026-98376",
              "CVE-2026-98420"
            ]
          },
          "package": {
            "const": "linux-libc-dev"
          },
          "version": {
            "const": "7.0.0-43.43"
          },
          "severity": {
            "const": "HIGH"
          },
          "type": {
            "const": "ubuntu"
          }
        }
      }
    },
    "finding_count": {
      "const": 8
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approval_id": {
            "type": "string",
            "minLength": 1
          },
          "prepared_by": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "approval_evidence": {
            "type": "string",
            "format": "uri"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending_independent_review"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approval_id": {
            "type": "null"
          },
          "prepared_by": {
            "type": "null"
          },
          "approved_by": {
            "type": "null"
          },
          "approval_evidence": {
            "type": "null"
          },
          "approved_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "revoked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
